# Running this docker image runs the integration tests.
FROM golang:1.27.1@sha256:e0174e51e81218523251d85d248a90d24c3d5e81543b4f07a5d66229397db190

# valkey-server and valkey-tools back "make tests_with_valkey". They install
# alongside redis without conflicting, so one image serves both runs.
RUN apt-get update -y && apt-get install sudo stunnel4 redis valkey-server valkey-tools memcached -y && rm -rf /var/lib/apt/lists/*

WORKDIR /workdir

ENV GOPROXY=https://proxy.golang.org
COPY go.mod go.sum /workdir/
RUN go mod download

COPY Makefile /workdir
RUN make bootstrap

COPY src /workdir/src
COPY test /workdir/test
CMD make tests_with_redis
